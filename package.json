{
  "name": "shinsa-piu-tournament",
  "version": "1.0.0",
  "description": "Pump It Up Tournament Web App - Swiss Rounds & King of the Hill",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx vite --host",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview:check": "node scripts/check-share-preview.mjs",
    "seed": "node server/db/seed.js",
    "piu:aliases": "node server/scripts/generatePiugameSongAliases.js --date=202602 --mode=total",
    "piu:jackets:sync": "node server/scripts/syncPiugameJackets.js --date=202602 --mode=total",
    "piu:tiers:import": "node server/scripts/importPiuScoresTierLists.js --tier-list-type=Pass",
    "piu:skills:import": "node server/scripts/importPiuCenterSkills.js",
    "piu:skills:metadata": "node server/scripts/scrapePiuCenterSkillMetadata.js",
    "piu:durations:scrape": "node server/scripts/scrapePiuCenterSongDurations.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.22.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "square": "^42.0.0",
    "tough-cookie": "^6.0.0",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "playwright": "^1.58.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "bn.js": "5.2.3"
  }
}
